{
  "name": "sdenv-rs-interface-version",
  "version": "1.1.5",
  "description": "sdenv reverse interface version with Node API, Python SDK and GUI launcher",
  "directories": {
    "test": "test"
  },
  "keywords": [
    "sdenv",
    "rs-reverse",
    "interface",
    "api",
    "cookie",
    "jsdom"
  ],
  "main": "index.js",
  "scripts": {
    "test": "jest ./test/",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand ./test/",
    "install": "node-gyp rebuild",
    "release": "release-it",
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "pack:check": "npm pack --dry-run"
  },
  "logLevel": "debug",
  "repository": {
    "type": "git",
    "url": "https://github.com/lasawang/sdenv-rs-interface-version.git"
  },
  "homepage": "https://github.com/lasawang/sdenv-rs-interface-version#readme",
  "bugs": {
    "url": "https://github.com/lasawang/sdenv-rs-interface-version/issues"
  },
  "author": "lasawang (derived from pysunday/sdenv)",
  "license": "BSD 3-Clause",
  "bin": {
    "sdenv-rs": "./example/use-check/index.js"
  },
  "dependencies": {
    "bindings": "^1.5.0",
    "canvas": "^3.2.0",
    "jest": "^29.7.0",
    "lodash": "^4.17.21",
    "log4js": "^6.9.1",
    "module-alias": "^2.2.3",
    "node-addon-api": "^7.0.0",
    "sdenv-extend": "^1.8.2",
    "sdenv-jsdom": "^2.1.0",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@release-it/conventional-changelog": "^8.0.1",
    "babel-jest": "^30.2.0",
    "release-it": "^17.0.1"
  },
  "gypfile": true,
  "engines": {
    "node": ">=20.19.5"
  },
  "_moduleAliases": {
    "sdenv": ".",
    "@": ".",
    "@handler": "./handler",
    "@utils": "./utils",
    "@bin": "./bin",
    "@jsdom": "sdenv-jsdom/lib/jsdom/"
  },
  "displayName": "sdenv-rs-interface-version",
  "source": {
    "upstream": "https://github.com/pysunday/sdenv",
    "note": "This project is derived from the upstream repository and contains interface-oriented modifications."
  },
  "files": [
    "index.js",
    "browser/**/*.js",
    "utils/**/*.js",
    "bin/**",
    "server/**/*.js",
    "python/*.py",
    "python/*.md",
    "python/*.bat",
    "python/*.sh",
    "binding.gyp",
    "README.md",
    "CHANGELOG.md",
    "DISCLAIMER.md",
    "NOTICE.md",
    "LICENSE",
    "example/use-check/index.js"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
